# --- Telegram ---------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user ids allowed to control the bot (@userinfobot)
TELEGRAM_OWNER_IDS=

# --- Chain ------------------------------------------------------------------
# robinhood | ethereum | base | any key, as long as CHAIN_ID + RPC_URLS are set
CHAIN=robinhood
# Comma separated. More endpoints = every call is raced, lowest latency wins.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# Only needed for a chain that is not preset (e.g. arc)
# CHAIN_ID=

# --- Wallet -----------------------------------------------------------------
# Hot wallet that pays for the copied mints. Leave empty to stay in dry run.
# Use a burner funded with only what you are willing to lose.
PRIVATE_KEY=

# --- Tuning -----------------------------------------------------------------
POLL_INTERVAL_MS=100
RPC_TIMEOUT_MS=4000
FEE_REFRESH_MS=2500
DATA_FILE=data/state.json
LOG_LEVEL=info
